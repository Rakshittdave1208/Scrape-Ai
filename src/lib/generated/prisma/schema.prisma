generator client {
  provider = "prisma-client-js"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  auditLogs   AuditLog[]
  credentials Credential[]
  customNodes CustomNode[]
  memberships Membership[]
  workflows   Workflow[]
  workspaces  Workspace[]
}

model CustomNode {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  name           String
  label          String
  icon           String
  category       String
  description    String?
  inputs         String
  outputs        String
  runtime        String
  code           String?
  config         String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([name, organizationId])
}

model Workspace {
  id             String       @id @default(cuid())
  name           String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  memberships    Membership[]
  workflows      Workflow[]
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([name, organizationId])
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  workspaceId    String?
  role           String
  workspace      Workspace?   @relation(fields: [workspaceId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([userId, organizationId, workspaceId])
}

model Workflow {
  id             String       @id @default(cuid())
  userId         String       @default("")
  createdById    String       @default("")
  organizationId String       @default("default-org")
  workspaceId    String       @default("default-workspace")
  name           String
  description    String?
  definition     String
  status         String       @default("DRAFT")
  visibility     String       @default("PRIVATE")
  locked         Boolean      @default(false)
  lockedById     String?
  lockedAt       DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  workspace      Workspace    @relation(fields: [workspaceId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([name, workspaceId])
}

model Credential {
  id             String       @id @default(cuid())
  organizationId String       @default("default-org")
  workspaceId    String?
  createdById    String       @default("")
  userId         String       @default("")
  name           String
  type           String
  value          String?
  apiKey         String?
  username       String?
  password       String?
  cookieValue    String?
  customHeaders  String?
  description    String?
  visibility     String       @default("PRIVATE")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([name, organizationId])
}

model AuditLog {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           String
  action         String
  resourceType   String
  resourceId     String
  metadata       String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model BillingAccount {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  planKey                 String    @default("FREE")
  status                  String    @default("free")
  workflowCredits         Int       @default(10000)
  architectureCredits     Int       @default(100000)
  workflowLimit           Int       @default(3)
  stripeCustomerId        String?   @unique
  stripeSubscriptionId    String?   @unique
  stripePriceId           String?
  stripeCurrentPeriodEnd  DateTime?
  stripeCancelAtPeriodEnd Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  organizationId          String?   @unique
}

model BillingEvent {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  userId        String?
  processedAt   DateTime @default(now())
}
